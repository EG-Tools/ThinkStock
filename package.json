{
  "name": "thinkstock-web-app",
  "version": "1.0.0",
  "private": true,
  "description": "ThinkStock local and GitHub Pages web app",
  "scripts": {
    "vendor:sync": "node scripts/build_plotly_bundle.cjs",
    "check:sources": "node scripts/check_javascript_sources.mjs",
    "build:web": "node scripts/sync_pdfjs_vendor.mjs && node scripts/check_javascript_sources.mjs --scope web && node scripts/build_pages_bundle.mjs",
    "test": "npm run build:web && npm run test:unit:built",
    "test:unit:built": "node scripts/check_javascript_sources.mjs --scope runtime && node --test tests/unit/*.test.mjs && node scripts/validate_pages_data_local.mjs && node scripts/validate_pages_app.mjs",
    "test:affected": "node scripts/test_affected.mjs",
    "test:quick": "npm run test:affected",
    "test:webkit": "npm run build:web && npm run test:webkit:built",
    "test:webkit:built": "playwright test --workers=2 --project=webkit --project=webkit-desktop --project=webkit-sw",
    "test:webkit:mobile": "npm run build:web && npm run test:webkit:mobile:built",
    "test:webkit:mobile:built": "playwright test --workers=1 --project=webkit",
    "test:webkit:smoke": "npm run build:web && node scripts/run_webkit_scope.mjs smoke",
    "test:webkit:sw": "npm run build:web && npm run test:webkit:sw:built",
    "test:webkit:sw:built": "node scripts/run_webkit_scope.mjs service-worker",
    "test:webkit:desktop": "npm run build:web && npm run test:webkit:desktop:built",
    "test:webkit:desktop:built": "playwright test --workers=1 --project=webkit-desktop",
    "check:local-render": "node scripts/check_local_pages_render.mjs",
    "version:pages": "node scripts/bump_pages_version.mjs",
    "checkpoint:local": "npm test && node scripts/bump_pages_version.mjs && npm run build:web && node scripts/validate_pages_app.mjs",
    "backtest:ai:prepare": "node scripts/prepare_ai_walkforward_data.mjs",
    "data:vkospi:bootstrap": "node scripts/fetch_stockplus_vkospi_history.mjs && node scripts/export_vkospi_pages_data.mjs",
    "data:vkospi": "node scripts/export_vkospi_pages_data.mjs",
    "data:fear-greed": "node scripts/refresh_fear_greed_pages_data.mjs",
    "data:news-sentiment": "node scripts/refresh_news_sentiment_pages_data.mjs",
    "backtest:ai": "node scripts/backtest_ai_forecast_walkforward.mjs",
    "backtest:ai:analyze": "node scripts/analyze_ai_walkforward_report.mjs",
    "backtest:ai:compare": "node scripts/compare_ai_walkforward_reports.mjs",
    "backtest:ai:verify": "node scripts/run_ai_walkforward_validation.mjs",
    "backtest:ai:summary": "node scripts/run_ai_walkforward_validation.mjs --summary-only",
    "backtest:ai:accept": "node scripts/run_ai_walkforward_validation.mjs --accept",
    "backtest:broker-reports": "node scripts/backtest_broker_report_weights.mjs",
    "backtest:qlib:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup_qlib_env.ps1",
    "backtest:qlib:prepare": "node scripts/export_qlib_krx_manifest.mjs",
    "backtest:qlib:quick": "node scripts/run_qlib_krx_challenger.mjs --quick --no-audit",
    "backtest:qlib": "node scripts/run_qlib_krx_challenger.mjs",
    "check:ai-validation": "node scripts/check_ai_validation_status.mjs",
    "worker:deploy": "wrangler deploy --keep-vars --config worker/wrangler.jsonc",
    "worker:check": "wrangler deploy --dry-run --config worker/wrangler.jsonc",
    "verify:release": "npm run build:web && npm run test:unit:built && npm run test:webkit:built",
    "release:pages": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release_pages.ps1"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pdfjs-dist": "6.2.108"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.23.9",
    "@playwright/test": "^1.61.1",
    "babel-loader": "^9.1.3",
    "esbuild": "^0.28.1",
    "ify-loader": "^1.1.0",
    "node-polyfill-webpack-plugin": "^4.1.0",
    "plotly.js": "2.35.2",
    "raw-loader": "^4.0.2",
    "stream-browserify": "^3.0.0",
    "through2": "^4.0.2",
    "transform-loader": "^0.2.4",
    "webpack": "^5.108.4",
    "wrangler": "^4.113.0"
  }
}
